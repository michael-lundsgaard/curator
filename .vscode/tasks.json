{
  "version": "2.0.0",
  "tasks": [
    // .NET solution tasks
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/apps/api/Curator.slnx", "--nologo", "-v:q"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "watch api",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "run", "--project", "${workspaceFolder}/apps/api/src/Curator.Api"],
      "isBackground": true,
      // The background patterns tell VS Code when the API is up, so "dev" can run both side by side
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOrBegins": true,
          "beginsPattern": "dotnet watch",
          "endsPattern": "Now listening on"
        }
      }
    },

    // App tasks (the npm scripts in apps/app also show up under Run Task on their own)
    {
      "label": "dev app",
      "type": "npm",
      "script": "dev",
      "path": "apps/app",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^never matches$" },
        "background": {
          "activeOrBegins": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "dev",
      "detail": "API (dotnet watch) and app (Vite) together",
      "dependsOn": ["watch api", "dev app"],
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/apps/api/Curator.slnx", "--nologo"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },

    // Docker tasks
    {
      "label": "docker up",
      "type": "shell",
      "command": "docker compose up -d"
    },
    {
      "label": "docker down",
      "type": "shell",
      "command": "docker compose down"
    },

    // Formatting tasks
    {
      "label": "format all",
      "dependsOrder": "sequence",
      "dependsOn": ["format api", "format rest"]
    },
    {
      "label": "format api",
      "type": "process",
      "command": "dotnet",
      "args": ["format", "${workspaceFolder}/apps/api/Curator.slnx"]
    },
    {
      "label": "format rest",
      "type": "process",
      "command": "npx",
      "args": ["prettier", "--write", "."]
    }
  ]
}
