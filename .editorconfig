root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

# EF Core migrations are generated (CRLF + BOM). Git normalizes line endings; dotnet format skips them.
[**/Migrations/*.cs]
generated_code = true
