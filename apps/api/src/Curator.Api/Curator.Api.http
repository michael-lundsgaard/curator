@host = http://localhost:5238
@supabase = https://jnofblywuslpfnouxniw.supabase.co

# Sign in first. Credentials come from a git-ignored .env file next to this one:
#   SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#   CURATOR_EMAIL=you@example.com
#   CURATOR_PASSWORD=...
# @name signIn
POST {{supabase}}/auth/v1/token?grant_type=password
apikey: {{$dotenv SUPABASE_PUBLISHABLE_KEY}}
Content-Type: application/json

{
  "email": "{{$dotenv CURATOR_EMAIL}}",
  "password": "{{$dotenv CURATOR_PASSWORD}}"
}

###

@token = {{signIn.response.body.access_token}}

GET {{host}}/health

###

GET {{host}}/me
Authorization: Bearer {{token}}

###

# Development only: sample clips to browse, some uploaded by you. No files are stored in R2.
POST {{host}}/dev/sample-data
Authorization: Bearer {{token}}

###

# Start an upload, then PUT the file to uploadUrl with the same Content-Type.
# @name startUpload
POST {{host}}/assets/uploads
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "filename": "Funny moment.mp4",
  "contentType": "video/mp4",
  "sizeBytes": 1048576,
  "recordedAt": "2026-10-16T20:15:00+02:00"
}

###

# After the PUT succeeded. Returns 409 until the file is in R2 with the announced size.
POST {{host}}/assets/{{startUpload.response.body.assetId}}/complete-upload
Authorization: Bearer {{token}}

###

# The library, newest recordings first. Also: q, sort (recorded, added, title), order (asc, desc), uploadedBy,
# recordedFrom, recordedTo.
# @name listAssets
GET {{host}}/assets?limit=20
Authorization: Bearer {{token}}

###

# The next page: same parameters plus the cursor.
GET {{host}}/assets?limit=20&cursor={{listAssets.response.body.nextCursor}}
Authorization: Bearer {{token}}

###
